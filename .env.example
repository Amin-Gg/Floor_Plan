# Phase 7 hardened production deployment example. Never commit real secrets.
APP_ENV=production
APP_CORS_ORIGINS=https://app.example.com
APP_ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
FLOORPLAN_PORT=8080
COMPLIANCE_PORT=8000

# Docker secret source files (create locally; each key >= 32 characters).
FLOORPLAN_API_KEYS_SECRET_FILE=./secrets/floorplan_api_keys.txt
COMPLIANCE_API_KEY_SECRET_FILE=./secrets/compliance_api_key.txt

# Process topology and hard timeouts
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=150
UVICORN_WORKERS=1
WORKER_CONCURRENCY=1
WORKER_MAX_TASKS_PER_CHILD=20
INFERENCE_TIMEOUT=90
INFERENCE_STARTUP_TIMEOUT=240
COMPLIANCE_JOB_SOFT_TIME_LIMIT=240
COMPLIANCE_JOB_HARD_TIME_LIMIT=300

# Public abuse controls
MAX_CONCURRENT_HEAVY_REQUESTS=1
RATE_LIMIT_HEAVY_PER_MINUTE=6
RATE_LIMIT_HEAVY_BURST=2
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_POLL_PER_MINUTE=180
ENGINE_SUBMIT_RATE_PER_MINUTE=30
ENGINE_SUBMIT_RATE_BURST=8
ENGINE_READ_RATE_PER_MINUTE=300
ENGINE_READ_RATE_BURST=75
MAX_REQUEST_BODY_MB=64
MAX_UPLOAD_MB=20
MAX_IFC_UPLOAD_MB=50
MAX_REPORT_ARTIFACT_MB=100
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=12000
MAX_IMAGE_ASPECT_RATIO=50

# Lifecycle and storage quotas
JOB_TTL_SECONDS=604800
INCOMING_TTL_SECONDS=3600
REDIS_MAXMEMORY=1gb
COMPLIANCE_JOBS_TMPFS_SIZE=1g
FLOORPLAN_SHM_SIZE=512m

# Container CPU/RAM limits
FLOORPLAN_MEMORY_LIMIT=8g
FLOORPLAN_CPU_LIMIT=4.0
COMPLIANCE_API_MEMORY_LIMIT=2g
COMPLIANCE_API_CPU_LIMIT=2.0
COMPLIANCE_WORKER_MEMORY_LIMIT=8g
COMPLIANCE_WORKER_CPU_LIMIT=4.0
REDIS_MEMORY_LIMIT=1536m
REDIS_CPU_LIMIT=1.0

# External artifact locations
WEIGHTS_DIR=./weights
COMPLIANCE_HF_CACHE_DIR=./compliance-engine/models/huggingface
RERANKER_DIR=./compliance-engine/models/bge_reranker

# Internal endpoint. TLS verification must remain enabled for HTTPS deployments.
COMPLIANCE_ENGINE_URL=http://compliance-api:8000
COMPLIANCE_TLS_VERIFY=1

# Optional compliance integrations
DATABASE_URL=
GROQ_API_KEYS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBED_MODEL=intfloat/multilingual-e5-large

# Build provenance
VCS_REF=unknown
BUILD_DATE=unknown
