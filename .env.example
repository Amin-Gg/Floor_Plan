# ============================================================================
# .env.example — copy to .env and fill in before `docker compose up`
# ============================================================================
# NEVER commit the real .env: it contains credentials.

# ── Required ─────────────────────────────────────────────────────────────────
# pgvector database with the ingested Mabhas clause embeddings (e.g. Neon).
DATABASE_URL=postgresql://user:password@host:5432/compliance

# Comma-separated Groq API keys (rotating pool for the RAG query transforms).
GROQ_API_KEYS=gsk_key1,gsk_key2

# ── Optional LLM providers ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Ports on the host ─────────────────────────────────────────────────────────
COMPLIANCE_PORT=8000
FLOORPLAN_PORT=8080

# ── Job store / workers ───────────────────────────────────────────────────────
# How long finished jobs (status + reports) stay downloadable, in seconds.
JOB_TTL_SECONDS=604800
# Concurrent compliance jobs per worker container. Scale containers with
# `docker compose up -d --scale compliance-worker=N` instead of raising this.
WORKER_CONCURRENCY=1
UVICORN_WORKERS=1
GUNICORN_WORKERS=1
REDIS_MAXMEMORY=1gb

# ── Model locations on the host ───────────────────────────────────────────────
# Section 1 checkpoints (maskrcnn_15_epochs.h5, yolo_best.pt) — mounted ro.
WEIGHTS_DIR=./weights
# bge-reranker-v2-m3 weights for the compliance engine — mounted ro.
RERANKER_DIR=./compliance-engine/models/bge_reranker

# ── Misc ─────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_CORS_ORIGINS=*
EMBED_MODEL=intfloat/multilingual-e5-large
