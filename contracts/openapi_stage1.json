    "schemas": {
      "AnalyzeFormRequest": {
        "additionalProperties": false,
        "description": "Documented multipart fields for POST /analyze.\n\nRuntime validation is performed by the same strict contract adapters used\nby direct exporter calls; these fields keep OpenAPI aligned with that public\nboundary.",
        "properties": {
          "image": {
            "description": "Floor-plan image (PNG/JPEG/WebP/TIFF).",
            "format": "binary",
            "title": "Image",
            "type": "string"
          },
          "manual_inputs": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Strict Manual Inputs v1.0 payload; see contracts/manual_inputs_v1.json.",
            "title": "Manual Inputs"
          },
          "scale_evidence": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Versioned Scale Evidence v1.0 payload; see contracts/scale_evidence_v1.json.",
            "title": "Scale Evidence"
          },
          "scale_factor_mm_per_pixel": {
            "default": 1.0,
            "description": "Legacy scalar fallback. Without scale_evidence it is classified as default_unverified.",
            "maximum": 100.0,
            "minimum": 0.01,
            "title": "Scale Factor Mm Per Pixel",
            "type": "number"
          }
        },
        "required": [
          "image"
        ],
        "title": "AnalyzeFormRequest",
        "type": "object"
      },
