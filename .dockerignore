# ============================================================================
# .dockerignore — what NOT to copy into the Docker build context
# ============================================================================
# Every path matched here is excluded from `COPY . /app` in the Dockerfile.
# Two reasons to exclude files:
#
#   1. Size    — model weights and datasets are large; never bake them in.
#   2. Security — never bake secrets, env files, or local config into an image.
#
# Verify what ends up in the image:
#   docker build -t floorplan3d-api:2.0 .
#   docker run --rm floorplan3d-api:2.0 find /app -type f | sort
# ============================================================================


# ── Python bytecode and caches ───────────────────────────────────────────────
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache
*.egg-info


# ── Virtual environments — rebuilt by Docker from requirements.txt ────────────
.venv
venv
env


# ── Model weights — mounted as a read-only volume at runtime ─────────────────
# These can be multiple gigabytes.  Baking them in would force a full weight
# transfer on every image rebuild, even when only code changed.
weights/*
!weights/.gitkeep
!weights/README.md


# ── Runtime outputs — mounted as a writable volume ───────────────────────────
outputs/
output/
*.ifc
*.json.gz


# ── Training and evaluation artifacts — never go in the serving image ─────────
train_mask2former.py
dataset/
data/
*.h5
*.hdf5


# ── Build and distribution artifacts ─────────────────────────────────────────
build/
dist/


# ── Scripts ───────────────────────────────────────────────────────────────────
# Production images need the artifact verifier during the builder stage.
# All other release, test and data-preparation scripts stay outside the image.
scripts/*
!scripts/verify_external_artifacts.py


# ── Separate compliance service — excluded from the Stage-1 image ─────────────
compliance-engine/


# ── Jupyter notebooks — useful during development, not in production ──────────
notebooks/
*.ipynb
.ipynb_checkpoints/


# ── Local development and IDE files ──────────────────────────────────────────
.git
.gitignore
.gitattributes
.github
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db


# ── Documentation ────────────────────────────────────────────────────────────
docs/
*.md
!README.md
!weights/README.md
TODO
NOTES


# ── Platform-specific deploy configs ─────────────────────────────────────────
# runtime.txt is a Heroku artifact; irrelevant in a Docker deployment.
runtime.txt


# ── Secrets — must never enter the image ─────────────────────────────────────
.env
.env.*
*.env
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/
credentials.json
*.credentials
auth.json


# ── Docker meta-files ────────────────────────────────────────────────────────
# Including the Dockerfile itself in the build context is harmless, but
# docker-compose files and .dockerignore itself add noise without value.
docker-compose*.yml
.dockerignore


# ── CI and test artifacts ────────────────────────────────────────────────────
.coverage
htmlcov/
coverage.xml
test-results/
*.log
logs/


# ── OS-specific files ────────────────────────────────────────────────────────
.Trash
.AppleDouble
.LSOverride

# ── Graphify code-map cache (dev tooling, machine-specific paths) ────────────
graphify-out/

# ── Compose secrets — never bake credentials into an image ───────────────────
.env
