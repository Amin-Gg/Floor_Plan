  <data key="d2">8-2-5-4c</data>
  <data key="d3">4</data>
  <data key="d4">definition</data>
  <data key="d5">در و پنجره</data>
  <data key="d6">» در« اتاق های خواب، چند منظوره و نشیمن باید از نوع لولایی یا پاشنه ای باشد.</data>
  <data key="d7">The doors of bedrooms, multipurpose rooms, and living rooms must be of louvered or hinged type.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
