  <data key="d2">1-1-1-7-4b</data>
  <data key="d3">7</data>
  <data key="d4">numeric</data>
  <data key="d5">__json__:null</data>
  <data key="d6">آ- عمق آزاد و بدون مانع فضای ورودی حداقل 40/1 متر و مساحت لازم آن حداقل 2 مترمربع است.</data>
  <data key="d7">The free, unobstructed depth of the entrance space must be at least 40.1 meters and its required area must be at least 2 square meters.</data>
