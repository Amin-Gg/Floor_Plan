  <data key="d3">4</data>
  <data key="d4">numeric</data>
  <data key="d5">__json__:null</data>
  <data key="d6">فضا های مورد استفاده برای اقامت، صرف غذا و پخت و پز باید دارای زیربنای حداقل20/00 مترمربع باشد.</data>
  <data key="d7">Spaces used for residence, dining and cooking must have a minimum floor area of 20.0 square metres.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
