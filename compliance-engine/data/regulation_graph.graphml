<node id="clause:2-4-8-5-4">
  <data key="d1">Clause</data>
  <data key="d2">2-4-8-5-4</data>
  <data key="d3">4</data>
  <data key="d4">spatial</data>
  <data key="d5">__json__:null</data>
  <data key="d6">2-4-8-5-4 برای تامین نور و هوای فضاهای اقامت و اشتغال توسط حیاطهای داخلی، سطوحی گودال باغچه محسوب میشوند که همه نقاط واقع بر کف آن در سطح افقی، توسط مخروطی فرضی با زاویه راس 45 درجه مستقیماً از گشودگی آسمان برخوردار باشند.</data>
  <data key="d7">2-4-8-5-4 To provide light and air to residential and occupied spaces via internal courtyards, the surface of a light well is considered such that every point on its horizontal floor is directly exposed to the sky through an imaginary cone with a 45-degree apex angle.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
