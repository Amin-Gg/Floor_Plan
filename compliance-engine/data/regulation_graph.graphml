  <data key="d4">spatial</data>
  <data key="d5">__json__:null</data>
  <data key="d6">4-4-8-5-4 در کف گودال باغچهها باید تمهیدات کافی برای هدایت و دفع نزولات جوی و دسترسی مناسب به منظور رسیدگی و نظافت آ نها پیش بینی شود.</data>
  <data key="d7">4-4-8-5-4 The floor of light wells must be provided with adequate provisions for drainage of rainwater and suitable access for reaching and cleaning them.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:1-1-9-5-4">
  <data key="d1">Clause</data>
  <data key="d2">1-1-9-5-4</data>
  <data key="d3">4</data>
  <data key="d4">definition</data>
  <data key="d5">__json__:null</data>
  <data key="d6">1-1-9-5-4 تمام فضاها و عناصر واسطی که برای رساندن نور و تهویه الزامی فضاهای قابل سکونت یا اشتغال ایجاد می‌شوند باید با الزامات این قسمت منطبق باشند.</data>
  <data key="d7">1-1-9-5-4 All spaces and intermediate elements created to provide the required light and ventilation for habitable or occupied spaces must comply with the requirements of this section.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:2-1-9-5-4">
  <data key="d1">Clause</data>
  <data key="d2">2-1-9-5-4</data>
  <data key="d3">4</data>
  <data key="d4">spatial</data>
  <data key="d5">__json__:null</data>
  <data key="d6">2-1-9-5-4 باید دسترسی مناسب به منظور رسیدگی و نظافت این فضاها و عناصر پیش بینی شده باشد.</data>
  <data key="d7">2-1-9-5-4 Suitable access for reaching and cleaning these spaces and elements must be provided.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:1-2-9-5-4">
  <data key="d1">Clause</data>
  <data key="d2">1-2-9-5-4</data>
  <data key="d3">4</data>
  <data key="d4">spatial</data>
  <data key="d5">__json__:null</data>
  <data key="d6">مجراهای خارجی نور و هوا که برای تامین نور و تهویه الزامی فضاها ایجاد می‌شوند نباید برای مقاصد دیگر مورد استفاده قرار گیرند.</data>
  <data key="d7">External light and air ducts that are created to provide mandatory lighting and ventilation for spaces must not be used for other purposes.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:2-2-9-5-4">
  <data key="d1">Clause</data>
  <data key="d2">2-2-9-5-4</data>
  <data key="d3">4</data>
  <data key="d4">numeric</data>
  <data key="d5">__json__:null</data>
  <data key="d6">این مجراها باید حداقل 50/1 متر عرض داشته باشند و با ارتفاع لازم در کنار دیوار خارجی در حیاط ها پیش بینی شوند.</data>
  <data key="d7">These ducts must have a minimum width of 0.5 meters and be provided at the required height alongside the external wall in courtyards.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:3-2-9-5-4">
  <data key="d1">Clause</data>
  <data key="d2">3-2-9-5-4</data>
  <data key="d3">4</data>
  <data key="d4">definition</data>
  <data key="d5">__json__:null</data>
  <data key="d6">برای محاسبه سطح نورگیر فضا ها در مجرای خارجی نور و هوا، تنها ارتفاع 90/0 مترِ سطح نورگذر و یا بازشو در زیرِ ترازِ زمین محاسبه می‌شود.</data>
  <data key="d7">For calculating the light-receiving surface of spaces in an external light and air duct, only a height of 0.9 meters of the light opening or an opening below ground level is considered.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:4-2-9-5-4">
  <data key="d1">Clause</data>
  <data key="d2">4-2-9-5-4</data>
  <data key="d3">4</data>
  <data key="d4">spatial</data>
  <data key="d5">__json__:null</data>
  <data key="d6">در صورتی که امکان عبور افراد یا وسایل نقلیه وجود داشته باشد، سطح فوقانی مجرای خارجی نور و هوا باید همسطح زمین باشد و توسط شبکه فلزی مستحکم در برابر عبور افراد یا وسایل نقلیه و با رعایت ضوابط عبور افراد معلول پوشیده و حفاظت شود.</data>
  <data key="d7">If passage of people or wheeled equipment is possible, the upper surface of the external light and air duct must be level with the ground and covered with a strong metal mesh to prevent passage of people or wheeled equipment, complying with accessibility rules for persons with disabilities.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:1-3-9-5-4">
  <data key="d1">Clause</data>
  <data key="d2">1-3-9-5-4</data>
  <data key="d3">4</data>
  <data key="d4">numeric</data>
  <data key="d5">__json__:null</data>
  <data key="d6">حداقل 60 درصد سطح داخلی دیوارهای محفظه آفتاب گیر باید از شیشه شفاف باشد.</data>
  <data key="d7">At least 60 percent of the internal wall surface of a sunroom enclosure must be transparent glass.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:2-3-9-5-4">
  <data key="d1">Clause</data>
  <data key="d2">2-3-9-5-4</data>
  <data key="d3">4</data>
  <data key="d4">numeric</data>
  <data key="d5">__json__:null</data>
  <data key="d6">حداقل 50 درصد از سطح شیشه الزامی محفظه آفتاب گیر باید بازشو باشد.</data>
  <data key="d7">At least 50 percent of the required glass surface of a sunroom enclosure must be an opening.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:3-3-9-5-4">
  <data key="d1">Clause</data>
  <data key="d2">3-3-9-5-4</data>
  <data key="d3">4</data>
  <data key="d4">spatial</data>
  <data key="d5">__json__:null</data>
  <data key="d6">برای تامین نور و تهویه الزامی یک فضای اقامت از طریق محفظه آفتاب گیر، سطح شیشه ای محفظه آفتابگیر نباید ازیک چهارم سطح کف محفظه به اضافه دو برابر سطح نورگذر الزامی مابین محفظه آفتاب گیر و فضای اقامتی که از طریق این محفظه نورگیری و تهویه می‌شود، کمتر باشد.</data>
  <data key="d7">To provide mandatory lighting and ventilation for a residential space through a sunroom enclosure, the glass surface area of the sunroom must not be less than one quarter of the floor area of the enclosure plus twice the required light opening area between the sunroom and the residential space it serves.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:4-3-9-5-4">
  <data key="d1">Clause</data>
  <data key="d2">4-3-9-5-4</data>
  <data key="d3">4</data>
  <data key="d4">spatial</data>
  <data key="d5">__json__:null</data>
  <data key="d6">نور و تهویه محفظه آفتا بگیر نباید از محفظه یا فضای سرپوشیده دیگری تامین شود.</data>
  <data key="d7">Lighting and ventilation of a sunroom enclosure must not be provided from another enclosed space or enclosure.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:5-3-9-5-4">
  <data key="d1">Clause</data>
  <data key="d2">5-3-9-5-4</data>
  <data key="d3">4</data>
  <data key="d4">spatial</data>
  <data key="d5">__json__:null</data>
  <data key="d6">پنجره فضاهای بهداشتی و آشپزخانه نباید به آن محفظه آفتاب گیر باز شود.</data>
  <data key="d7">The openings of sanitary and kitchen spaces must not open onto the sunroom enclosure.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:6-3-9-5-4">
  <data key="d1">Clause</data>
  <data key="d2">6-3-9-5-4</data>
  <data key="d3">4</data>
  <data key="d4">spatial</data>
  <data key="d5">__json__:null</data>
  <data key="d6">در این محفظه آفتابگیر نباید تاسیسات گرمایشی یا سرمایشی که از انواع سوخت جامد، مایع یا گاز استفاده می‌کنند، یا دستگاه های هوادهی که نیاز به هوای تازه دارند نصب شود، مگر آن که تامین هوای تازه مورد نیاز آن ها به صورت مستقیم از فضای باز فراهم شده باشد و تاسیسات یادشده به دودکش مناسب مطابق مقررات و استانداردهای مربوط مجهز باشند.</data>
  <data key="d7">In this sunroom enclosure, heating or cooling installations that use solid, liquid, or gas fuels, or air-conditioning units requiring fresh air, must not be installed unless fresh air is supplied directly from an open space and the installations are equipped with appropriate exhaust systems in accordance with relevant regulations and standards.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:7-3-9-5-4">
  <data key="d1">Clause</data>
  <data key="d2">7-3-9-5-4</data>
  <data key="d3">4</data>
  <data key="d4">definition</data>
  <data key="d5">__json__:null</data>
  <data key="d6">برای کفسازی و پوشش دیوارها باید الزامات تعیین شده برای فضاهای نیمه باز رعایت شود.</data>
  <data key="d7">For flooring and wall covering, the specified requirements for semi-open spaces must be observed.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:9-1-10-5-4">
  <data key="d1">Clause</data>
  <data key="d2">9-1-10-5-4</data>
  <data key="d3">4</data>
  <data key="d4">definition</data>
  <data key="d5">__json__:null</data>
  <data key="d6">پیش بینی کفشوی در توقفگاه های متوسط و بزرگ الزامی است.</data>
  <data key="d7">Forecasting of pavement in medium and large parking areas is mandatory.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:10-1-10-5-4">
  <data key="d1">Clause</data>
  <data key="d2">10-1-10-5-4</data>
  <data key="d3">4</data>
  <data key="d4">definition</data>
  <data key="d5">__json__:null</data>
  <data key="d6">در توقفگاههای متوسط و بزرگ باید از علایم هشدار دهنده و انتظامی مندرج در مبحث بیستم مقررات ملی ساختمان استفاده شود.</data>
  <data key="d7">In medium and large parking areas, warning and regulatory signs listed in Chapter 20 of the National Building Regulations must be used.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:11-1-10-5-4">
  <data key="d1">Clause</data>
  <data key="d2">11-1-10-5-4</data>
  <data key="d3">4</data>
  <data key="d4">spatial</data>
  <data key="d5">__json__:null</data>
  <data key="d6">در صورتی که ساختمانی امکان اتصال به دو یا چند معبر در رده عملکردی اصلی و فرعی از نظر حمل و نقل را داشته باشد (مثلا اگر در میادین و تقاطع ها واقع باشد)، مسیر دسترسی به ساختمان باید از معبر با رده عملکردی پایین تر و محلی تر تامین گردد؛ مگر اینکه نهاد قانونی مسیول، با توجه به شرایط موجود و ملاحظات ایمنی و سایر شرایط تاثیرگذار، دسترسی از معبر با رده عملکردی بالاتر را الزام یا تصویب نماید.</data>
  <data key="d7">If a building can be accessed by two or more primary or secondary traffic routes (e.g., located at squares or intersections), the access route to the building must be provided through a lower‑performance, more local passage, unless the responsible legal authority, considering existing conditions, safety considerations, and other influencing factors, mandates or approves access via a higher‑performance passage.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:1-2-10-5-4a">
  <data key="d1">Clause</data>
  <data key="d2">1-2-10-5-4a</data>
  <data key="d3">4</data>
  <data key="d4">numeric</data>
  <data key="d5">__json__:null</data>
  <data key="d6">ارتفاع مجاز توقفگاه های کوچک خودرو، به منظور تقلیل خطرات ناشی از حریق، از کف تا سطح زیرین سقف و یا درصورت وجود تاسیسات یا عناصر سازه ای در زیر سقف، تا پایین ترین نقطه آن ها حداقل 20/2 متر است.</data>
  <data key="d7">The permissible height of small vehicle parking areas, to reduce fire hazards, shall be at least 20/2 meters from the floor to the underside of the ceiling, or to the lowest point of any installations or structural elements below the ceiling.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="element:parking">
  <data key="d1">Element</data>
  <data key="d13">parking</data>
  <data key="d14">__json__:null</data>
</node>
