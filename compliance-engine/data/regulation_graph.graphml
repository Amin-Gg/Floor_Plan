  <data key="d1">Clause</data>
  <data key="d2">1-3-5-4</data>
  <data key="d3">4</data>
  <data key="d4">numeric</data>
  <data key="d5">__json__:null</data>
  <data key="d6">فضا هایی که هم برای اقامت و هم صرف غذا مورد استفاده قرار میگیرند، باید حداقل 14/50 مترمربع زیر بنا داشته باشند.</data>
  <data key="d7">Spaces that are used both for residence and for dining must have a minimum floor area of 14.5 square metres.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
  <data key="d10">__json__:null</data>
</node>
<node id="clause:2-3-5-4">
  <data key="d1">Clause</data>
