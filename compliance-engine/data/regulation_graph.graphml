  <data key="d3">7</data>
  <data key="d4">numeric</data>
  <data key="d5">__json__:null</data>
  <data key="d6">حداقل پهنای الزامی راهروهای مستقیم و پله های داخلی تصرف های مسکونی 90/0 متر است.</data>
  <data key="d7">The minimum required width of straight corridors and internal stairs of residential units is 0.90 meters.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
