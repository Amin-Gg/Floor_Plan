  <data key="d3">7</data>
  <data key="d4">numeric</data>
  <data key="d5">__json__:null</data>
  <data key="d6">اندازه سایر فضاها و اتاق های اقامتی در تصرف های مسکونی، بر اساس نحوه استفاده آن ها مشخص شده و حداقل عرض 40/2 متر است.</data>
  <data key="d7">The minimum width of other accommodation spaces and rooms in residential occupancies is 2.40 m.</data>
  <data key="d8">__json__:["all_residential"]</data>
  <data key="d9">__json__:["any"]</data>
