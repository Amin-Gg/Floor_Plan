# ============================================================================
# Mabhas Compliance Engine — environment template
# Copy to .env and fill in real values. NEVER commit .env (already in
# .gitignore / .dockerignore). Real keys live only in the environment.
# ============================================================================

# ---- Database (required for RAG retrieval) --------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/compliance

# ---- Regulation corpus (required in production) ----------------------------
CLAUSES_PATH=data/mabhas_clauses.json

# ---- LLM providers ----------------------------------------------------------
# Provider resolution (LLM_PROVIDER=auto): AgentRouter wins when its key is
# set, else Groq, else fully-offline mode (interpretive clauses stay
# NEEDS_REVIEW). Pin explicitly with LLM_PROVIDER=agentrouter or =groq.
LLM_PROVIDER=auto
LLM_PASS_ENABLED=1

# AgentRouter (OpenAI-compatible gateway) — key from
# https://agentrouter.org/console/token
AGENTROUTER_API_KEY=sk-your-agentrouter-token-here
AGENTROUTER_MODEL=claude-sonnet-4-5-20250929
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# AGENTROUTER_TIMEOUT_S=60
# AGENTROUTER_MAX_RETRIES=3

# Groq (9-key rotating pool, qwen/qwen3-32b) — leave empty if unused
GROQ_API_KEYS=
# GROQ_API_KEY=

# ---- One-time / offline stages ----------------------------------------------
# ANTHROPIC_API_KEY=            # Stage 1 contextual retrieval (index pass)
# OPENAI_API_KEY=               # Step 1 offline Mabhas classification

# ---- Job store / workers ------------------------------------------------------
# CELERY_BROKER_URL=redis://localhost:6379/0
# JOB_STORE_REDIS_URL=
# JOB_TTL_SECONDS=604800
# RESULTS_DIR=/tmp/compliance_jobs

# ---- Retrieval stack toggles ---------------------------------------------------
# CRAG_ENABLED=1
# GRAPH_ENABLED=1
# EMBED_MODEL=intfloat/multilingual-e5-large
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
